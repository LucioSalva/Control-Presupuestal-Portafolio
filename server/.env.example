# ================================================================
#  CONTROL PRESUPUESTAL MUNICIPAL — .env.example
# ================================================================
#  Copia este archivo a `.env` y completa los valores reales.
#  NUNCA commitees el archivo .env real con secretos.
# ================================================================

# ── BASE DE DATOS ──────────────────────────────────────────────
# Cadena de conexión Postgres. Formato:
#   postgres://USUARIO:PASSWORD@HOST:PUERTO/BASE
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/presupuesto_db

# SSL al conectar con Postgres. En la mayoría de los despliegues
# municipales locales: false. Si vas a un Postgres administrado
# (RDS, Render, Supabase, etc.) suele ser true.
PGSSL=false

# Conexiones máximas del pool de Postgres (default 20).
PG_POOL_MAX=20

# ── SERVIDOR ───────────────────────────────────────────────────
# Puerto HTTP donde escucha Express.
PORT=3000

# Modo de ejecución. Valores: development | test | staging | production.
# En production se exigen ALLOWED_ORIGINS y JWT_SECRET con longitud >= 32.
NODE_ENV=production

# Lista comma-separated de orígenes que pueden hacer CORS contra la API.
# OBLIGATORIO en production. Ejemplo:
#   ALLOWED_ORIGINS=https://presupuestal.municipio.example,https://staging.presupuestal.municipio.example
ALLOWED_ORIGINS=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────
# Secreto para firmar tokens JWT. Mínimo 32 caracteres en production.
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NUNCA commitees el valor real. NUNCA reutilices el mismo secreto
# entre environments distintos.
JWT_SECRET=CHANGE_ME_genera_uno_con_crypto_randomBytes_64

# ── ARRANQUE ───────────────────────────────────────────────────
# Si es "true", al iniciar el servidor se ejecuta
# seedPartidasPermitidas() para repoblar la tabla de partidas
# permitidas por DG/DA. Idempotente, pero es mejor dejarlo en
# false en producción y correrlo manualmente solo cuando se
# necesite.
SEED=false

# ── PREFIJO DE FOLIO ───────────────────────────────────────────
# Usado en la generación de folios MUN-YYYY-MM-...-NNNN.
# Cambiarlo solo si el municipio adopta el sistema (p. ej. otro municipio).
MUNICIPIO_PREFIJO_FOLIO=MUN
